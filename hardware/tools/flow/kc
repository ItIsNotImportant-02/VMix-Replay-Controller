#!/bin/bash
# run a command inside KiCad 9 container with repo hardware dir mounted at /hw
docker info >/dev/null 2>&1 || { (dockerd >/tmp/claude-0/dockerd.log 2>&1 &); for i in $(seq 1 40); do docker info >/dev/null 2>&1 && break; sleep 1; done; }
HW=${HW:-/home/user/VMix-Replay-Controller/hardware}
docker run --rm -u $(id -u) -e HOME=/tmp/home -e DEFAULT_W=${DEFAULT_W:-0.2} -e IN2_SIGNAL=${IN2_SIGNAL:-} -e IN2_KEEP_PLANE=${IN2_KEEP_PLANE:-} -e MV=${MV:-2} -e MR=${MR:-3} -e RND=${RND:-2} -e STEPS=${STEPS:-} -e MAXW=${MAXW:-} -e SILKDBG=${SILKDBG:-} -e SPREAD=${SPREAD:-} -e SPR_R=${SPR_R:-} -e VIA_D=${VIA_D:-} -e VIA_DRILL=${VIA_DRILL:-} -v $HW:/hw -v /tmp/claude-0/kt:/kt -w /hw kicad/kicad:9.0 bash -c '
mkdir -p $HOME/.config/kicad/9.0
cp /usr/share/kicad/template/sym-lib-table /usr/share/kicad/template/fp-lib-table $HOME/.config/kicad/9.0/ 2>/dev/null
'"$*"
